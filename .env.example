# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Server-Side Binance Futures/Spot API Keys (for live order execution via backend proxy)
# Leave unset to run in Live Market Paper Auto-Trade mode using real-time Binance market feeds.
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BINANCE_USE_TESTNET="true"
